# ============================================
# Backend (AdonisJS) Environment Variables
# ============================================
# This file contains variables for the AdonisJS backend only.
# For other components, see:
#   - worker/.env.example   (Python workers: SoloQ + Pro)
#   - frontend/.env.local.example (Next.js frontend)
# ============================================

# === Server Configuration ===
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=your-random-32-character-app-key
NODE_ENV=development
SESSION_DRIVER=cookie

# === Database ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=esports_tracker
# Enable SSL for database connection (REQUIRED for production)
# In production, certificate validation is enforced (rejectUnauthorized: true)
# In development, certificate validation is disabled for self-signed certs
DB_SSL=false

# === Redis (required for production rate limiting) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# === CORS Configuration ===
# REQUIRED IN PRODUCTION: Set this to your frontend domain(s)
# Comma-separated list of allowed origins
# Example: https://esports.example.com,https://www.esports.example.com
# WARNING: If not set in production, all cross-origin requests will be denied
CORS_ALLOWED_ORIGINS=

# === SoloQ Worker API Security ===
# REQUIRED IN PRODUCTION: Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This secret authenticates requests from the Python SoloQ worker to backend API endpoints
# WARNING: Application will refuse to start in production without this secret
# In development, if not set, worker endpoints will return 500 errors but app will still start
WORKER_API_SECRET=

# Optional: Restrict worker API access to specific IPs (comma-separated)
# Leave empty to allow from any IP (signature validation only)
# Example: 127.0.0.1,::1,10.0.0.5
WORKER_ALLOWED_IPS=

# === Proxy Configuration ===
# IMPORTANT: Only set this if the application is behind a reverse proxy (nginx, cloudflare, etc.)
# Comma-separated list of trusted proxy IPs that are allowed to set X-Forwarded-* headers
# If not set, X-Forwarded-* headers are IGNORED (secure default)
# Example for Hostinger VPS with nginx: 127.0.0.1,::1
# Example for Cloudflare: See https://www.cloudflare.com/ips/
TRUSTED_PROXY_IPS=

# === Pro Monitoring Admin API Key ===
# REQUIRED IN PRODUCTION: Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This API key protects pro monitoring write endpoints (sync, clean-tables, leagues management)
# Used by: frontend pro monitoring dashboard to trigger syncs
PRO_ADMIN_API_KEY=

# === Pro Stats Page Password ===
# Simple shared password for UX gate on /pro/stats page (not a security barrier)
PRO_STATS_PASSWORD=

# === SoloQ Admin Page Password ===
# Simple shared password for UX gate on /admin page (not a security barrier)
SOLOQ_ADMIN_PASSWORD=

# === Reference Only (used by worker, not backend) ===
# RIOT_API_KEY is configured in worker/.env, not here