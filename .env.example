# ============================================
# Esports Tracker - Root Environment Variables
# ============================================
# These variables are used by docker-compose.yml
# For component-specific variables, see:
#   - backend/.env.example  (AdonisJS backend)
#   - worker/.env.example   (Python workers)
#   - frontend/.env.local.example (Next.js frontend)
# ============================================

# === Docker Compose (shared services) ===
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=esports_tracker

# Redis (required for production rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=false

# === Worker (passed to container) ===
# Riot Games API - Get your key at: https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-your-api-key-here

# ============================================
# Analytics (Umami)
# ============================================
# Secret key for Umami (generate with: openssl rand -hex 32)
UMAMI_APP_SECRET=change-me-in-production
