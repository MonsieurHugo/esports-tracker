# ============================================
# Frontend Environment Variables
# ============================================
# Copy this file to .env.local and update values

# Backend API URL (for proxy rewrite)
NEXT_PUBLIC_API_URL=http://localhost:3333

# WebSocket URL (for real-time updates)
NEXT_PUBLIC_WS_URL=ws://localhost:3333

# Pro Worker API URL (direct API for tournament fetching)
NEXT_PUBLIC_WORKER_API_URL=http://localhost:8000

# ============================================
# Analytics (Umami)
# ============================================
# Get these values from your Umami dashboard after first setup
# Leave empty to disable tracking
NEXT_PUBLIC_UMAMI_URL=https://analytics.monsieuryordle.com
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
