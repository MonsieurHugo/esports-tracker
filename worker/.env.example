# ============================================
# Worker Environment Variables
# ============================================
# This file contains variables for Python workers.
# The project has TWO separate workers:
#   - SoloQ Worker (python -m src.main)     - Uses Riot API
#   - Pro Worker   (python -m src.main_pro) - Uses GRID API
#
# For other components, see:
#   - backend/.env.example  (AdonisJS backend)
#   - frontend/.env.local.example (Next.js frontend)
# ============================================

# === Shared: Database (REQUIRED for both workers) ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/esports_tracker

# === Shared: Redis ===
REDIS_URL=redis://localhost:6379

# === Shared: Application Settings ===
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# SoloQ Worker Only (python -m src.main)
# ============================================

# Riot Games API (REQUIRED for SoloQ worker)
# Get your API key from https://developer.riotgames.com/
RIOT_API_KEY=your-riot-api-key
RIOT_API_RATE_LIMIT=100

# Priority Queue Settings (V2)
USE_PRIORITY_QUEUE=true

# Activity tier thresholds (score 0-100)
PRIORITY_TIER_VERY_ACTIVE=70.0
PRIORITY_TIER_ACTIVE=40.0
PRIORITY_TIER_MODERATE=20.0

# Base refresh intervals by tier (in minutes)
PRIORITY_INTERVAL_VERY_ACTIVE=3
PRIORITY_INTERVAL_ACTIVE=15
PRIORITY_INTERVAL_MODERATE=60
PRIORITY_INTERVAL_INACTIVE=240

# Maximum intervals (caps for backoff)
PRIORITY_MAX_INTERVAL_VERY_ACTIVE=5
PRIORITY_MAX_INTERVAL_ACTIVE=30
PRIORITY_MAX_INTERVAL_MODERATE=120
PRIORITY_MAX_INTERVAL_INACTIVE=360

# Batch size per region per cycle
PRIORITY_BATCH_SIZE=10

# ============================================
# Pro Worker Only (python -m src.main_pro)
# ============================================

# GRID API (REQUIRED for Pro worker)
# Get your API key from https://grid.gg/
GRID_API_KEY=your-grid-api-key
GRID_API_RATE_LIMIT=10

# Pro Worker Settings
PRO_TOURNAMENT_YEAR=2026
PRO_MAX_CONCURRENT_GAMES=5
PRO_SYNC_INTERVAL_MINUTES=5
PRO_API_PORT=8000
PRO_API_HOST=0.0.0.0

# ============================================
# Leaguepedia Sync (python -m src.sync_leaguepedia)
# ============================================

# Leaguepedia bot credentials (optional, recommended for higher rate limits)
LEAGUEPEDIA_USERNAME=
LEAGUEPEDIA_PASSWORD=

# Maximum year to sync from Leaguepedia (avoid overlap with GRID data)
LEAGUEPEDIA_MAX_YEAR=2025
